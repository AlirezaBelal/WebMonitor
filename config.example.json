{
  "check_interval_seconds": 300,
  "request_timeout_seconds": 10,
  "max_attempts": 3,
  "backoff_seconds": 1,
  "health_file": ".webmonitor/health.json",
  "user_agent": "WebMonitor/4.0 (+https://github.com/AlirezaBelal/WebMonitor)",
  "targets": [
    {
      "name": "homepage",
      "target_url": "https://example.com/",
      "css_selector": "body",
      "comparison_mode": "text",
      "notification": {
        "backend": "console",
        "title": "WebMonitor change detected",
        "message": "Homepage content changed."
      }
    },
    {
      "name": "docs",
      "target_url": "https://example.com/docs",
      "css_selector": "main",
      "comparison_mode": "html",
      "max_attempts": 2,
      "notification": {
        "backend": "webhook",
        "webhook_url_env": "WEBMONITOR_WEBHOOK_URL",
        "title": "WebMonitor change detected",
        "message": "Documentation content changed."
      }
    }
  ]
}
